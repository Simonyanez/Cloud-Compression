@inproceedings{malvar_adaptive_2006,
	title = {Adaptive run-length/{Golomb}-{Rice} encoding of quantized generalized {Gaussian} sources with unknown statistics},
	url = {https://ieeexplore.ieee.org/document/1607237},
	doi = {10.1109/DCC.2006.5},
	abstract = {We present a simple and efficient entropy coder that combines run-length and Golomb-Rice encoders. The encoder automatically switches between the two modes according to simple rules that adjust the encoding parameters based on the previous output codeword, and the decoder tracks such changes. This adaptive run-length/Golomb-Rice (RLGR) coder has a fast learning rate, making it suitable for many practical applications, which usually involve encoding small source blocks. We study the encoding of generalized Gaussian (GG) sources after quantization with uniform scalar quantizers with deadzone, which are good source models in multimedia data compression, for example. We show that, for a wide range of source parameters, the RLGR encoder has a performance close to that of the optimal Golomb-Rice and exp-Golomb coders designed with knowledge of the source statistics, and in some cases the RLGR coder improves coding efficiency by 20\% or more.},
	urldate = {2025-06-06},
	booktitle = {Data {Compression} {Conference} ({DCC}'06)},
	author = {Malvar, H.S.},
	month = mar,
	year = {2006},
	note = {ISSN: 2375-0359},
	keywords = {Data compression, Decoding, Encoding, Entropy, Gaussian distribution, Laplace equations, Quantization, Statistical distributions, Statistics, Switches},
	pages = {23--32},
	file = {RLGR.pdf:/home/simao/Zotero/storage/6MXIEBGD/RLGR.pdf:application/pdf;Snapshot:/home/simao/Zotero/storage/92LNWRU5/1607237.html:text/html},
}

