\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Arquitectura Integral del Sistema:} Interacción asimétrica entre Codificador y Decodificador. En el codificador, el filtro $\tau _{\text  {gate}}$ poda el espacio de búsqueda forzando modo 0 en zonas de baja varianza. El decodificador es puramente determinista y no requiere calcular varianzas: desempaqueta los índices de modo $M_p$ directamente desde el flujo CABAC y aplica la base ortonormal correspondiente.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:gating_pipeline}{{1}{5}{\textbf {Arquitectura Integral del Sistema:} Interacción asimétrica entre Codificador y Decodificador. En el codificador, el filtro $\tau _{\text {gate}}$ poda el espacio de búsqueda forzando modo 0 en zonas de baja varianza. El decodificador es puramente determinista y no requiere calcular varianzas: desempaqueta los índices de modo $M_p$ directamente desde el flujo CABAC y aplica la base ortonormal correspondiente}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Evaluación Experimental y Resultados de Tasa-Distorsión}{5}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Curvas de Tasa-Distorsión Reales a través de las 4 Escalas ($B_c \in \{32, 16, 8, 4\}$):} Comparación entre la línea base estructural (línea discontinua negra) y las curvas propuestas con bitstream real PyRLGR y sobrecarga CABAC, para $K \in \{4,8,16,24\}$, graficadas frente al PSNR real completamente decodificado. En $B_c\in \{16,8,4\}$ cada punto es la media sobre las 14 secuencias en ese paso de cuantización $Q$; el panel $B_c=32$ es \texttt  {longdress} únicamente ($n=1$). No se dibujan barras de error: la dispersión de BPV entre secuencias al mismo $Q$ es real y grande (coeficiente de variación 34\%-71\% según $(B_c,Q)$, por ejemplo 0.223 a 2.166 BPV en $B_c=16,K=24,Q=24$) porque cada secuencia tiene una entropía de contenido intrínsecamente distinta al mismo paso de cuantización -- graficarla como barra de error solo produce trazos que dominan la figura sin aportar lectura útil; la curva mostrada es la media real.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:rd_master}{{2}{6}{\textbf {Curvas de Tasa-Distorsión Reales a través de las 4 Escalas ($B_c \in \{32, 16, 8, 4\}$):} Comparación entre la línea base estructural (línea discontinua negra) y las curvas propuestas con bitstream real PyRLGR y sobrecarga CABAC, para $K \in \{4,8,16,24\}$, graficadas frente al PSNR real completamente decodificado. En $B_c\in \{16,8,4\}$ cada punto es la media sobre las 14 secuencias en ese paso de cuantización $Q$; el panel $B_c=32$ es \texttt {longdress} únicamente ($n=1$). No se dibujan barras de error: la dispersión de BPV entre secuencias al mismo $Q$ es real y grande (coeficiente de variación 34\%-71\% según $(B_c,Q)$, por ejemplo 0.223 a 2.166 BPV en $B_c=16,K=24,Q=24$) porque cada secuencia tiene una entropía de contenido intrínsecamente distinta al mismo paso de cuantización -- graficarla como barra de error solo produce trazos que dominan la figura sin aportar lectura útil; la curva mostrada es la media real}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces BD-Rate promedio $\pm $ desviación estándar por $(B_c, K)$, agregado sobre las 14 secuencias (\texttt  {frame\_idx=1}, malla completa $Q\in \{24,32,48,64\}$ por secuencia). $K=30$ excluido: la corrida de fondo que lo produce aún no completa más que 2/14 secuencias. $B_c=32$ excluido de esta tabla por la misma razón que en la Fig.~\ref  {fig:rd_master}: solo \texttt  {longdress} tiene cobertura ahí ($n=1$), no es comparable con una media de $n=14$. La ganancia crece de forma monótona con $K$ en las tres escalas, pero con magnitudes bastante menores que en una única secuencia, y $B_c=16$ -- no $B_c=32$ -- es la escala con mejor desempeño promedio entre las que tienen cobertura completa.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:bjontegaard}{{1}{6}{BD-Rate promedio $\pm $ desviación estándar por $(B_c, K)$, agregado sobre las 14 secuencias (\texttt {frame\_idx=1}, malla completa $Q\in \{24,32,48,64\}$ por secuencia). $K=30$ excluido: la corrida de fondo que lo produce aún no completa más que 2/14 secuencias. $B_c=32$ excluido de esta tabla por la misma razón que en la Fig.~\ref {fig:rd_master}: solo \texttt {longdress} tiene cobertura ahí ($n=1$), no es comparable con una media de $n=14$. La ganancia crece de forma monótona con $K$ en las tres escalas, pero con magnitudes bastante menores que en una única secuencia, y $B_c=16$ -- no $B_c=32$ -- es la escala con mejor desempeño promedio entre las que tienen cobertura completa}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mejor configuración por secuencia ($B_c^*, K^*$ que minimizan BD-Rate, ajuste cúbico log-tasa sobre los 4 puntos $Q\in \{24,32,48,64\}$) frente a la línea base estructural emparejada. Valores derivados de \texttt  {results/exp\_e10\_multisequence.db} (14 secuencias, \texttt  {frame\_idx=1}). Promedio: BD-Rate $=-2.034\%$, BD-PSNR $=+0.088$ dB.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:master_rd}{{2}{7}{Mejor configuración por secuencia ($B_c^*, K^*$ que minimizan BD-Rate, ajuste cúbico log-tasa sobre los 4 puntos $Q\in \{24,32,48,64\}$) frente a la línea base estructural emparejada. Valores derivados de \texttt {results/exp\_e10\_multisequence.db} (14 secuencias, \texttt {frame\_idx=1}). Promedio: BD-Rate $=-2.034\%$, BD-PSNR $=+0.088$ dB}{table.2}{}}
