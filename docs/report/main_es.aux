\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Matriz de Correlación de Parámetros Algorítmicos (E10, $n=14$ secuencias):} Coeficientes de correlación lineal de Pearson entre las variables de control ($\tau _{\text  {gate}}, K, \gamma , B_c, Q$) y las métricas de ahorro real (\%), conmutaciones Trellis, razón overhead:ahorro y cobertura GFT (\%), agrupando \texttt  {frame\_idx=1} de las 14 secuencias. Mapa de color divergente (\texttt  {coolwarm}) centrado en cero, apropiado para correlaciones con signo en $[-1,1]$.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:param_sensitivity}{{3}{8}{\textbf {Matriz de Correlación de Parámetros Algorítmicos (E10, $n=14$ secuencias):} Coeficientes de correlación lineal de Pearson entre las variables de control ($\tau _{\text {gate}}, K, \gamma , B_c, Q$) y las métricas de ahorro real (\%), conmutaciones Trellis, razón overhead:ahorro y cobertura GFT (\%), agrupando \texttt {frame\_idx=1} de las 14 secuencias. Mapa de color divergente (\texttt {coolwarm}) centrado en cero, apropiado para correlaciones con signo en $[-1,1]$}{figure.3}{}}
