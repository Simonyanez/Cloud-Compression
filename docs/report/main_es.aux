\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Transiciones Trellis y Carga Útil CABAC ($B_c=16$, media sobre $n=14$ secuencias):} (a) Frecuencia de transiciones de modo ($M_p \ne  M_{p-1}$) en función del paso $Q$; (b) Tamaño del flujo de sobrecarga CABAC (Bytes). Sin barras de error: la dispersión entre secuencias es real y grande (p.~ej. 204-1103 conmutaciones en $K=24,Q=24$) por lo que se reporta como número en el texto en vez de como barra que domina la figura.}}{13}{figure.7}\protected@file@percent }
