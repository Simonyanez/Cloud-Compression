\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Estructura Espacial 3D e Inclinación Esférica de Clústers, 4 secuencias representativas:} por cada fila, (a) nube de puntos original coloreada por luminancia $Y$; (b) centroides de los bloques macro padre ($B_p=32$ para las 8iVFB/MVUB de profundidad 10, $B_p=16$ para \texttt  {ricardo9}) coloreados según el ángulo de inclinación esférica del clúster asignado ($\theta \in [0^\circ , 90^\circ ]$), azul=vertical, rojo=horizontal.}}{11}{figure.5}\protected@file@percent }
